{
  // Tests (vitest) und lokale Entwicklung (npm run dev): derselbe Code als Worker mit statischen Dateien.
  // Online läuft derselbe Worker mit echter Datenbank und eigener Adresse – siehe wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fahrtenbuch-lokal",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fahrtenbuch",
      "database_id": "1c554ee1-b81c-49a5-b351-314eda944046",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OEFFENTLICHE_ADRESSE": "https://fahrtenbuch.smarte.events",
    "APP_PAKET": "at.zweibit.fahrtenbuch",
    "APP_ZERTIFIKAT_SHA256": "6F:76:48:B0:3E:4D:9C:F7:9A:A0:75:91:D7:B9:BC:F3:1A:07:4A:B6:A0:34:1B:BA:3E:AF:67:DA:89:8D:B1:BB"
  }
}

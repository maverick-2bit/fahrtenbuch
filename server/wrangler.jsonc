  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fahrtenbuch",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fahrtenbuch",
      "database_id": "1c554ee1-b81c-49a5-b351-314eda944046",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OEFFENTLICHE_ADRESSE": "https://fahrtenbuch.2bit.at",
    "APP_PAKET": "at.zweibit.fahrtenbuch",
    // SHA-256-Fingerabdruck des App-Signaturschlüssels (für Android App Links)
    "APP_ZERTIFIKAT_SHA256": "6F:76:48:B0:3E:4D:9C:F7:9A:A0:75:91:D7:B9:BC:F3:1A:07:4A:B6:A0:34:1B:BA:3E:AF:67:DA:89:8D:B1:BB"
  }
}
